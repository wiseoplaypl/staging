            <div class="menu-tabs">
                <div class="js-top-menu mobile" id="_mobile_top_menu"></div>
                <div id="_mobile_verticalmenu"></div>
                <div class="js-top-menu-bottom">
                </div>
            </div>
        </div>

        {hook h='displayNavFullWidth'}
    {/block}

